{
  "version": 6,
  "configurePresets": [
    {
      "name": "win32",
      "displayName": "Win32 (clang-cl + xwin, MSVC ABI)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/clang-cl-x86.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "win32", "configurePreset": "win32" }
  ]
}
